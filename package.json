{
    "name": "isaac-utils",
    "version": "0.2.1",
    "description": "",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "vite:build": "vite build",
        "build": "cross-env TAURI_SIGNING_PRIVATE_KEY=$HOME/.tauri/isaac-utils.key tauri build",
        "build:nostrip": "cross-env TAURI_SIGNING_PRIVATE_KEY=$HOME/.tauri/isaac-utils.key NO_STRIP=true tauri build",
        "build:verbose": "cross-env TAURI_SIGNING_PRIVATE_KEY=$HOME/.tauri/isaac-utils.key tauri build --verbose",
        "build:nostrip:verbose": "cross-env TAURI_SIGNING_PRIVATE_KEY=$HOME/.tauri/isaac-utils.key NO_STRIP=true tauri build --verbose",
        "build:linux": "cross-env TAURI_SIGNING_PRIVATE_KEY=$HOME/.tauri/isaac-utils.key tauri build -t x86_64-unknown-linux-gnu",
        "build:linux:nostrip": "cross-env TAURI_SIGNING_PRIVATE_KEY=$HOME/.tauri/isaac-utils.key NO_STRIP=true tauri build -t x86_64-unknown-linux-gnu",
        "build:linux:verbose": "cross-env TAURI_SIGNING_PRIVATE_KEY=$HOME/.tauri/isaac-utils.key tauri build -t x86_64-unknown-linux-gnu --verbose",
        "build:linux:nostrip:verbose": "cross-env TAURI_SIGNING_PRIVATE_KEY=$HOME/.tauri/isaac-utils.key NO_STRIP=true tauri build -t x86_64-unknown-linux-gnu --verbose",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "tauri": "tauri"
    },
    "license": "MIT",
    "dependencies": {
        "@bwip-js/browser": "^4.9.2",
        "@tauri-apps/api": "2.10.1",
        "@tauri-apps/plugin-clipboard-manager": "2.3.2",
        "@tauri-apps/plugin-dialog": "2.7.0",
        "@tauri-apps/plugin-fs": "2.5.0",
        "@tauri-apps/plugin-global-shortcut": "2.3.1",
        "@tauri-apps/plugin-notification": "~2.3.3",
        "@tauri-apps/plugin-opener": "~2.5.3",
        "@tauri-apps/plugin-process": "2.3.1",
        "@tauri-apps/plugin-shell": "2.3.5",
        "@tauri-apps/plugin-updater": "2.10.1",
        "fast-deep-equal": "^3.1.3",
        "file-type": "^22.0.1",
        "luxon": "^3.7.2",
        "mime": "^4.1.0",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.57.1",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@tauri-apps/cli": "2.10.1",
        "@types/luxon": "^3.7.1",
        "autoprefixer": "^10.5.0",
        "cross-env": "^10.1.0",
        "postcss": "^8.5.10",
        "sass": "^1.99.0",
        "svelte": "^5.55.4",
        "svelte-check": "^4.4.6",
        "tailwindcss": "^3.4.9",
        "tslib": "^2.8.1",
        "typescript": "^5.5.4",
        "vite": "^6.3.5"
    },
    "packageManager": "pnpm@11.0.0-rc.2+sha512.26410cc26d668baddde13a0acf2c75cad00b82a477bcc1e2fe629dd41d6b78fe3fb2d9bb523afff79d6a91f06be9b90a6032543f30b5f73931239c820aa5f001"
